# ---- LLM (any OpenAI-compatible API) ----
# Leave LLM_API_KEY empty to run in offline "mock" mode (no external calls).
LLM_API_KEY=
LLM_MODEL=

# ---- Retrieval ----
# "default" = Chroma's built-in MiniLM embeddings (downloads ~80MB on first use)
# "hash"    = tiny offline embedding, only for tests/demos without internet
EMBEDDING_BACKEND=default
TOP_K=3

LOG_LEVEL=INFO
